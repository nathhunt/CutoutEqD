{
  "dotnet.defaultSolution": "CutoutEqD.sln",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "publish": true
  },
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
