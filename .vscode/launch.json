{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CutoutEqD (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CutoutEqD.App/bin/Debug/net8.0-windows/CutoutEqD.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "CutoutEqD (Debug, open image…)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CutoutEqD.App/bin/Debug/net8.0-windows/CutoutEqD.exe",
      "args": ["${input:imagePath}"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/CutoutEqD.Tests/bin/Debug/net8.0/CutoutEqD.Tests.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "imagePath",
      "type": "promptString",
      "description": "Path to a scanned image"
    }
  ]
}
