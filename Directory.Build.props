<Project>

  <!-- Shared by every project. Bump Version here for a release; the build adds the git commit
       (e.g. 1.1.0+3f2a9c1…) to InformationalVersion, which the app shows as its build version. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Company>Cutout Equivalent Diameter</Company>
    <Copyright>© $([System.DateTime]::UtcNow.Year)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

</Project>
